# Copy to apps/server/.env and fill in. Loaded at server startup (cutlab/config.py).
# The real OS environment always wins over this file. Never commit .env.

# --- AI Director / Recap LLM (optional; default backend is "manual") ---
# CUTLAB_LLM_BACKEND=openrouter        # manual | openrouter | anthropic
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# CUTLAB_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Telegram approval gate (optional) ---
# CUTLAB_TELEGRAM_TOKEN=                # from @BotFather
# CUTLAB_TELEGRAM_CHAT_ID=              # chat the bot posts gates to
# CUTLAB_TELEGRAM_APPROVERS=            # comma-separated numeric user IDs allowed to decide
# Optional local U2-Net ONNX model used by still-image background cutout.
# CUTLAB_CUTOUT_MODEL=C:\path\to\u2netp.onnx
# Optional Piper voice model. Without Fish Audio credentials, Text to Sound
# uses Piper at this path (default: data/voices/en_US-lessac-medium.onnx).
# Install piper-tts and download a licensed .onnx voice model plus its .json.
# CUTLAB_PIPER_VOICE=data/voices/en_US-lessac-medium.onnx
# Optional override for the installed MixFix production engine connection.
# CUTLAB_MIXFIX_ROOT=C:\path\to\CutLab\engines\mixfix
