# Optional standalone API mode. Agent runs use operator mode instead.
OPENROUTER_API_KEY=
AGENT_OPERATOR=1

# --- Optional: LLM used for viral moment detection + titles/captions ---
# Any model id from https://openrouter.ai/models works. Examples:
#   anthropic/claude-sonnet-4.5     (default - best quality)
#   openai/gpt-4.1                  (strong alternative)
#   google/gemini-2.5-flash         (cheap + fast)
#   meta-llama/llama-3.3-70b-instruct  (very cheap)
# Prefix with ~ to DISABLE all LLM calls (agent mode: seed moments.json yourself).
# LLM_MODEL=anthropic/claude-sonnet-4.5

# --- Optional: Whisper transcription settings ---
# Model size: tiny / base / small / medium / large-v3 (bigger = slower + more accurate)
# WHISPER_MODEL=small
# Device: auto / cpu / cuda (use cuda if you have an NVIDIA GPU)
# WHISPER_DEVICE=auto

# --- Optional: YouTube downloads ---
# Browser to take cookies from when YouTube asks for sign-in
# (chrome / edge / firefox / brave / opera). Leave empty to auto-try all.
# YT_BROWSER=
# Max download resolution (short side). 1080 = sharp but small files.
# DL_MAX_RES=1080

# --- Optional: blur layout ---
# Share of frame height the video fills in blur style (landscape sources).
# 0.5 = 25% blurred / 50% video / 25% blurred. Higher = bigger video, more
# cropped off its left/right edges.
# BLUR_VIDEO_PCT=0.5

# --- Optional: default output style ---
# blur | center | split | face  (asked per run; this only sets the menu default)
# STYLE=blur

# --- Optional: clip length (seconds) ---
# CLIP_MIN_SECONDS=60
# CLIP_MAX_SECONDS=120

# --- Optional: clip selection ---
# Quality bar (0-100): only clips the strict judge scores >= this are kept.
# Higher = fewer, better clips. Number of clips is dynamic, capped by MAX_CLIPS.
# CLIP_QUALITY_BAR=72
# MAX_CLIPS=12
