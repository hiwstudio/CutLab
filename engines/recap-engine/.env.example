# Optional standalone API mode. Agent runs use manual mode and no key.
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4.5
# Story brain: manual (agent hand-off) or openrouter (automatic API)
LLM_BACKEND=manual

# Standard recap-length window for LONG sources (>= 60 min). Short sources are
# prompted for a length at runtime and that choice is used as-is.
RECAP_MIN_MINUTES=12
RECAP_MAX_MINUTES=22

# Voiceover: fish (Fish Audio API, default) or piper (local fallback).
TTS_ENGINE=piper
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free # paid models 402 without API credit
FISH_VOICE_ID=           # voice reference id from fish.audio; blank = default voice
FISH_FORMAT=wav
PIPER_VOICE=voices/en_US-lessac-medium.onnx

# Whisper + downloads (same as clip engine)
WHISPER_MODEL=small
YT_BROWSER=firefox
DL_MAX_RES=1080
